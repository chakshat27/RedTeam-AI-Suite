# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Attacker LLM (generates adversarial prompts) ---
# [V3] provider: groq, openai, together, fireworks, ollama, or anthropic
ATTACKER_PROVIDER=groq
ATTACKER_MODEL=llama-3.3-70b-versatile
ATTACKER_BASE_URL=
GROQ_API_KEY=

# --- Judge LLM (scores results — MUST be a different model family from the target) ---
# [V3] provider: gemini, anthropic, or any OpenAI-compatible provider name
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-flash-latest
JUDGE_BASE_URL=
GEMINI_API_KEY=

# --- [V3] Additional provider credentials for the multi-provider registry ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=

# --- Target execution ---
TARGET_REQUEST_TIMEOUT_SECONDS=30.0
MAX_REQUESTS_PER_SECOND=2.0
TARGET_API_KEY=

# --- Storage ---
DATABASE_PATH=./data/red_team.db
# [V3] Set to switch to Postgres instead of SQLite, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/redteam
DATABASE_URL=

# [V3] Set to enable Redis-backed multi-instance WS fan-out, e.g.:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- CI gate ---
CI_FAIL_ON_SEVERITIES=["critical","high"]

# --- [V3] Backend authentication (leave unset for open/local single-user use) ---
BACKEND_API_KEY=

# --- App ---
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
